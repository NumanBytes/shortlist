// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  LIBRARY
  DATABASE
  TOOL
  PLATFORM
  CONCEPT
}

// WHERE the experience came from.
enum EvidenceContext {
  COMMERCIAL // paid work
  PERSONAL // side projects, self-learning
  ACADEMIC // university coursework
}

// HOW DEEP the experience goes — separates "I built with it" from "I kept it running".
enum EvidenceDepth {
  PRODUCTION // built features that shipped and are in use
  WORKING // can build independently, not shipped commercially
  MAINTENANCE // upgraded / fixed / operated, but did not build
  EXPOSURE // tutorials, coursework, small experiments
}

enum RequirementImportance {
  REQUIRED
  PREFERRED
  BONUS
}

enum GapSeverity {
  BLOCKING // core stack missing — do not apply
  MODERATE // learnable, will be probed in interview
  MINOR // peripheral, unlikely to block an offer
}

enum JobStatus {
  DISCOVERED
  INTERESTED
  SKIPPED
  APPLIED
  ASSESSMENT
  INTERVIEWING
  REJECTED
  OFFER
  WITHDRAWN
}

// Where a job is in the AI pipeline (docs/ai-scoring.md §12).
enum JobAnalysisStatus {
  PENDING // waiting to be analysed
  DONE // requirements extracted and scored
  DEFERRED // over the nightly/monthly budget; retried next run — never silently dropped
  FAILED // the model call or its validation failed; see analysisError
}

enum MatchVerdict {
  APPLY
  STRETCH
  SKIP
}

enum AiPurpose {
  ANALYZE_JOB // requirement extraction + skill mapping (Haiku)
  EXTRACT_EMAIL // jobs read out of an alert email no code parser handles (Haiku)
  TAILOR_RESUME // later (Sonnet)
  DISCOVER_SOURCES // later (web search)
}

enum JobSourceType {
  ATS_BOARD
  AGGREGATOR_API
  EMAIL_INBOX
  MANUAL
}

enum DiscoveryRunStatus {
  RUNNING
  SUCCESS
  FAILED
  EMPTY
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  name         String
  headline     String?
  targetRole   String?
  location     String?
  // Resume header (contact line). Personal data: lives only in the database — never in
  // committed files (seed data, docs).
  phone        String?
  linkedinUrl  String?
  githubUrl    String?

  refreshTokens   RefreshToken[]
  workExperiences WorkExperience[]
  skills          Skill[]
  projects        Project[]
  jobSources      JobSource[]
  jobs            Job[]
  discoveryPrefs  DiscoveryPreferences?
  aiSettings      AiSettings?
  education       Education[]
  neverClaims     NeverClaim[]
  aiUsage         AiUsage[]
  resumeVariants  ResumeVariant[]
  gmail           GmailConnection?
  oauthStates     OAuthState[]
  emailMessages   EmailMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Hand-rolled auth: refresh tokens are stored so they can be revoked.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model WorkExperience {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String
  title     String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)
  location  String?

  evidence SkillEvidence[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A project done as part of a paid role (e.g. a banking portal built at CloudCard).
  // Null = a personal project. Evidence linked to such a project is commercial work.
  workExperienceId String?
  workExperience   WorkExperience? @relation(fields: [workExperienceId], references: [id], onDelete: SetNull)
  name             String
  description      String?
  liveUrl          String?
  repoUrl          String?
  isShipped        Boolean         @default(false)
  // Always on a tailored resume (docs/resume.md §13.7): tailoring only rewords and orders its
  // bullets. Not a claim — changing it never un-verifies evidence.
  isPinned         Boolean         @default(false)
  startDate        DateTime?
  endDate          DateTime?

  evidence SkillEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Skill {
  id       String        @id @default(uuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  category SkillCategory

  evidence SkillEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One row per skill name per user — no duplicate "React" / "React.js" entries.
  @@unique([userId, name])
  @@index([userId])
}

// THE CORE TABLE. One skill can carry several different truths at once —
// e.g. PostgreSQL: COMMERCIAL/PRODUCTION at work AND PERSONAL/WORKING on a side project.
model SkillEvidence {
  id      String @id @default(uuid())
  skillId String
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  context EvidenceContext
  depth   EvidenceDepth

  // What was actually done, in the user's own words.
  // This is the ONLY source a resume bullet may be derived from. Never invented.
  whatIDid String

  lastUsed DateTime

  // Optionally linked to where the evidence came from (at most one should be set).
  workExperienceId String?
  workExperience   WorkExperience? @relation(fields: [workExperienceId], references: [id], onDelete: SetNull)
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Nothing renders onto a resume until the user has confirmed it out loud.
  // THIS IS THE AZURE-INCIDENT SAFEGUARD. Do not weaken this default.
  isVerified Boolean   @default(false)
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skillId])
  @@index([context, depth])
  @@index([isVerified])
}

// Toggleable job source — disabling a source is a data change, never a code change.
model JobSource {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Stable identity, e.g. "greenhouse:gomotive" — what seeding and re-seeding match on.
  key  String
  name String // display name, e.g. "Motive"

  type   JobSourceType
  config Json // validated by JobSourceConfigSchema in @shortlist/shared

  isEnabled     Boolean             @default(true)
  lastRunAt     DateTime?
  lastRunStatus DiscoveryRunStatus?

  discoveryRuns DiscoveryRun[]
  jobs          Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

// Opened in RUNNING state BEFORE the fetch starts — an empty or failed source must
// be visibly distinguishable from "no run today."
model DiscoveryRun {
  id          String    @id @default(uuid())
  jobSourceId String
  jobSource   JobSource @relation(fields: [jobSourceId], references: [id], onDelete: Cascade)

  status       DiscoveryRunStatus @default(RUNNING)
  startedAt    DateTime           @default(now())
  finishedAt   DateTime?
  jobsFound    Int                @default(0) // everything the source returned
  jobsMatched  Int                @default(0) // passed the rule filter
  jobsNew      Int                @default(0) // matched and not seen before
  errorMessage String?

  jobs Job[] // jobs first discovered by this run

  @@index([jobSourceId, startedAt])
}

model Job {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  company  String
  location String?
  workMode String?

  source    String? // provider, e.g. "greenhouse", "remoteok" — shown as attribution
  sourceUrl String? // the original posting; "Apply" always links here
  rawJD     String  @db.Text
  // From a job-alert email (docs/email-alerts.md §10.5): only the alert's summary is known until the
  // user pastes the full description, or the same job turns up on a board that has it.
  isPartial Boolean @default(false)
  salary    String? // as the source wrote it ("Rs 60,000 - Rs 70,000 a month")

  // Guards against the same posting appearing from multiple sources.
  dedupeHash String

  jobSourceId    String?
  jobSource      JobSource?    @relation(fields: [jobSourceId], references: [id], onDelete: SetNull)
  discoveryRunId String? // the run that first found it
  discoveryRun   DiscoveryRun? @relation(fields: [discoveryRunId], references: [id], onDelete: SetNull)

  status       JobStatus @default(DISCOVERED)
  postedAt     DateTime?
  discoveredAt DateTime  @default(now())
  lastSeenAt   DateTime  @default(now()) // bumped on every run that still lists it
  appliedAt    DateTime?

  requirements JobRequirement[]
  match        JobMatch?
  resume       JobResume?

  // AI analysis (docs/ai-scoring.md §12)
  analysisStatus   JobAnalysisStatus @default(PENDING)
  analysisError    String?
  analyzedAt       DateTime?
  seniority        String? // JUNIOR | MID | SENIOR | LEAD | UNKNOWN, as the posting states it
  yearsRequired    Int? // overall years the posting asks for, if stated
  redFlags         String[] // scam / suspicious-posting signals the model noticed
  // The verified skills the model was shown. The model can only map requirements to
  // these, so once the user verifies a skill outside this set, the job needs a fresh
  // analysis (re-scoring the old mapping can't discover the new match).
  analyzedSkillIds String[]
  aiUsage          AiUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, dedupeHash])
  @@index([userId, status])
  @@index([userId, discoveredAt])
}

// The cheap, no-AI rule filter that runs before anything reaches a model (docs/architecture.md §5).
// Data, not code: tuning what gets through is an update, never a redeploy. A user
// without a row gets DEFAULT_DISCOVERY_PREFERENCES from @shortlist/shared.
model DiscoveryPreferences {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titleInclude       String[] // title must contain one of these
  titleExclude       String[] // ...and none of these
  stackKeywords      String[] // title or description must mention one of these
  roleTitleTerms     String[] // no description (alert emails): stack keyword in title/summary, or one of these in the title
  onsiteLocations    String[] // on-site/hybrid roles must be in one of these
  allowRemote        Boolean
  remoteAllowRegions String[] // a remote role passes only if limited to these regions (or worldwide)
  maxPostingAgeDays  Int

  updatedAt DateTime @updatedAt
}

model JobRequirement {
  id    String @id @default(uuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  skillName     String
  importance    RequirementImportance
  yearsRequired Int?
  isCore        Boolean               @default(false) // central to the role, not a nice-to-have

  // Which of the user's VERIFIED skills satisfy this requirement — chosen by the model
  // only from the list it was given, then checked in code. Scores are computed from this
  // mapping, so a change to evidence re-scores without another model call.
  matchedSkillIds String[] // the same technology (or a direct equivalent): full credit
  relatedSkillIds String[] // transferable but NOT the same (Redux vs React): half credit, never claimed as the skill

  @@index([jobId])
}

model JobMatch {
  id    String @id @default(uuid())
  jobId String @unique
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  // Computed in code from JobRequirement.matchedSkillIds + evidence strength — never
  // produced by the model, so the same inputs always give the same score.
  overallScore    Int // 0-100
  commercialScore Int // 0-100, counting only COMMERCIAL evidence
  verdict         MatchVerdict

  strengths String[]
  risks     String[]

  gaps       SkillGap[]
  computedAt DateTime   @default(now())
}

model SkillGap {
  id         String   @id @default(uuid())
  jobMatchId String
  jobMatch   JobMatch @relation(fields: [jobMatchId], references: [id], onDelete: Cascade)

  skillName String
  severity  GapSeverity
  note      String?

  @@index([jobMatchId])
  @@index([skillName])
}

// Resume library (docs/resume.md §13.2–13.4). A variant is one tailored resume; many jobs can
// use the same one. Its content cites evidence by ID, and whether it is stale is DERIVED
// from that evidence at read time (un-verified, edited since, or deleted) rather than
// flagged by every write path — a future write path can't forget to mark it.
model ResumeVariant {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status             ResumeStatus @default(DRAFT)
  content            Json // ResumeContent (packages/shared/src/resume.ts), Zod-validated on write
  // Every evidence item the resume relies on (bullets + skills). No FK: a deleted item must
  // leave a trace so the variant reads as stale, not silently shrink.
  evidenceIds        String[]
  // Normalized requirement names of the job it was tailored for — what reuse compares.
  requirementProfile String[]
  model              String

  generatedAt DateTime  @default(now())
  approvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  jobs JobResume[]

  @@index([userId])
}

enum ResumeStatus {
  DRAFT // generated; the user hasn't confirmed every bullet yet
  APPROVED // read and confirmed — may be reused without another review
}

// Which resume a job uses, and the state of preparing it. "What did I send Kwanso?" is
// answerable from here.
model JobResume {
  id        String         @id @default(uuid())
  jobId     String         @unique
  job       Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ResumeVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  status  JobResumeStatus
  error   String?
  reused  Boolean         @default(false)
  overlap Float? // requirement overlap when reused

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum JobResumeStatus {
  PENDING // queued or being tailored
  READY
  DEFERRED // budget or configuration — retry later
  FAILED
}

// Budget guard (docs/ai-scoring.md §12.3). Runtime settings per user — the cost dial is data,
// not a constant. A user without a row gets DEFAULT_AI_SETTINGS from shared.
model AiSettings {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  maxAnalysesPerDay     Int // job analyses per rolling 24h
  monthlyBudgetUsd      Decimal @db.Decimal(8, 2) // stop all AI calls once this month's spend reaches it
  resumeReuseMinOverlap Decimal @default(0.85) @db.Decimal(3, 2) // offer an approved resume for reuse at this overlap

  updatedAt DateTime @updatedAt
}

// One row per model call: what it cost and why it was made. The budget guard sums these;
// the Sources page shows month-to-date spend from them.
model AiUsage {
  id     String  @id @default(uuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId  String?
  job    Job?    @relation(fields: [jobId], references: [id], onDelete: SetNull)

  purpose          AiPurpose
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int       @default(0)
  cacheWriteTokens Int       @default(0)
  costUsd          Decimal   @db.Decimal(12, 6)
  succeeded        Boolean // false = the call was billed but its output was rejected

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Terms a generated resume must never contain — the user's own known false claims (docs/resume.md
// §13.8). Data, not code: they were a hardcoded Azure / Node.js-at-work check in shared code
// until 2026-10-13. Only the user edits the list; tailoring reads it and refuses any bullet
// that mentions a term in its scope.
model NeverClaim {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  term  String // matched as a whole term, case-insensitive; "Node.js" also matches "Node"
  scope NeverClaimScope @default(ANYWHERE)
  note  String? // why it's false, in the user's words

  createdAt DateTime @default(now())

  @@unique([userId, term, scope])
  @@index([userId])
}

enum NeverClaimScope {
  ANYWHERE // never on the resume
  PAID_WORK // never in a bullet about paid work (Experience, or a project done in a role)
}

model Education {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  degree      String // e.g. "Bachelor of Science in Information Technology"
  institution String
  location    String?
  startYear   Int?
  endYear     Int? // null = in progress

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Email job alerts (docs/email-alerts.md §10) ──────────────────────────────────────────

// The user's Gmail, connected read-only. The refresh token is the only credential and is
// stored encrypted (AES-256-GCM, bound to the user id); access tokens are never stored.
// The worker reads ONLY messages under `labelName`.
model GmailConnection {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emailAddress    String
  refreshTokenEnc String // SecretBox "v1.<iv>.<tag>.<ciphertext>"
  labelName       String @default("Shortlist")

  status    GmailStatus @default(ACTIVE)
  lastError String?

  connectedAt     DateTime            @default(now())
  lastCheckedAt   DateTime?
  // Health of the last check, shown like a source's last run: never a silent blank.
  lastCheckStatus DiscoveryRunStatus?
  lastCheckFound  Int? // new labelled messages read by the last check

  updatedAt DateTime @updatedAt
}

enum GmailStatus {
  ACTIVE
  NEEDS_RECONNECT // Google refused the grant (revoked, expired) — the user must reconnect
}

// One pending "Connect Gmail" attempt. `stateHash` ties Google's redirect back to the user
// who started it; `nonceHash` ties it to the same BROWSER (a cookie), so an attacker can't
// send someone their own consent link and attach the victim's mailbox to the attacker's
// account (OAuth login CSRF). Single use, 10-minute life.
model OAuthState {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stateHash    String   @unique
  nonceHash    String
  codeVerifier String // PKCE; useless without the authorization code, gone in 10 minutes
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// One row per labelled Gmail message the worker has read: never read twice. Metadata
// only — the body is parsed in memory and never stored.
model EmailMessage {
  id             String @id @default(uuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  gmailMessageId String

  sender       String? // the From address
  portal       String? // e.g. "indeed", "arc.dev" — which source its jobs are credited to
  receivedAt   DateTime
  status       EmailStatus
  parser       String? // "indeed" (code) or "ai" (model fallback)
  note         String? // e.g. "Indeed parser found no jobs — read by AI": a parser may be out of date
  // A code parser found nothing in (or threw on) what should be an alert, so the model read
  // it: the portal probably changed its email layout. Counted on the Sources page.
  parserFailed Boolean     @default(false)
  jobsFound    Int         @default(0)
  error        String?
  readAt       DateTime    @default(now())

  @@unique([userId, gmailMessageId])
  @@index([userId, readAt])
}

enum EmailStatus {
  PARSED
  NOT_ALERT // labelled, but not a job alert (an application receipt, a newsletter)
  UNPARSED // read before parsing existed (2026-10-03); never produced now
  DEFERRED // needed the model, but the budget or API key wasn't there — retried next check
  FAILED // couldn't be read (invalid model output, a parser threw)
}
