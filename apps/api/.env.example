NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/shortlist"

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Comma-separated browser origins allowed to send the refresh cookie cross-origin.
WEB_ORIGINS=http://localhost:5173

# Redis for enqueueing jobs the worker runs (redis:// locally, rediss:// in production)
REDIS_URL=redis://localhost:6379
