NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5432/shortlist"
# redis:// locally; rediss:// (TLS) for Upstash in production
REDIS_URL=redis://localhost:6379
# Nightly discovery schedule, in DISCOVERY_TZ (default 02:00 Lahore time)
DISCOVERY_CRON="0 2 * * *"
DISCOVERY_TZ=Asia/Karachi
WORKER_CONCURRENCY=3

# Claude API key — create at console.anthropic.com. Only the worker has it (Agents.md §4).
# Without it, jobs are still discovered but AI scoring is deferred.
ANTHROPIC_API_KEY=sk-ant-...
# Nightly analysis sweep (re-queues pending/deferred jobs, re-scores after evidence changes)
ANALYSIS_CRON="0 3 * * *"
ANALYSIS_CONCURRENCY=2

# Gmail job alerts (Agents.md §10.6) — all three or none; same values as the API.
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# TOKEN_ENCRYPTION_KEY=
# How often connected inboxes are checked (default: every two hours at :15).
# GMAIL_CHECK_CRON=15 */2 * * *
