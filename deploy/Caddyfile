# Caddy: the only thing exposed to the internet (Agents.md §4).
#  - HTTPS: for a real hostname (SITE_ADDRESS=numan-shortlist.duckdns.org) Caddy gets and
#    renews a Let's Encrypt certificate by itself. A phone only installs the PWA over HTTPS.
#  - /api/* and /health go to the API; everything else is the built React app.
#  - One origin for both, so the SameSite=Strict refresh cookie works (Agents.md §8.2) —
#    the same arrangement as Vite's proxy in development.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# Hashed build files never change: cache them for a year.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		# The page and the service worker must always be re-checked, or a phone keeps
		# running an old version of the app after a deploy.
		@shell path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		# A client-side route (/jobs/123) has no file: serve the app and let it route.
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}
