# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets on the server with the commands shown.

# The server's public hostname (no https://). Caddy gets its HTTPS certificate for it.
# e.g. a free DuckDNS subdomain pointing at the server's IP.
SITE_ADDRESS=numan-shortlist.duckdns.org

# openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_ACCESS_SECRET=

# Claude (worker only). Without it, scoring and tailoring wait as "deferred".
ANTHROPIC_API_KEY=

# Gmail job alerts — all four, or none (docs/email-alerts.md §10.6).
# TOKEN_ENCRYPTION_KEY must be the SAME value as on your laptop if you bring your local
# database over: the stored Gmail token was encrypted with it. New key: openssl rand -base64 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://numan-shortlist.duckdns.org/api/v1/gmail/callback
TOKEN_ENCRYPTION_KEY=

# Push notifications — all three, or none (docs/notifications.md §19). Generate a key pair on
# your laptop with: pnpm --filter @shortlist/worker vapid:keys
# Keep the same pair once phones have subscribed: a new pair makes every device re-enable.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Account emails: sign-up verification and "Forgot password" (docs/security.md §8.7) — all four
# (SMTP_PORT defaults to 587), or none. Any SMTP server: e.g. Gmail with an app password
# (smtp.gmail.com, your address, a 16-character app password from your Google account's
# security settings), or Brevo / Mailgun / Zoho. Unset: new accounts are verified at once
# and password reset by email is unavailable.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Shortlist <you@example.com>
# SMTP_PORT=587

# Optional
# Off-site backup check-in URL (e.g. https://hc-ping.com/<uuid>): emails you when a night's
# Google Drive copy fails or doesn't happen (README, "Off-site copies").
# OFFSITE_PING_URL=
# DISCOVERY_TZ=Asia/Karachi
# HTTP_PORT=80
# HTTPS_PORT=443
